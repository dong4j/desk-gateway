# YD-ESP32-S3 N16R8：16MB Flash + Octal 8MB PSRAM
CONFIG_IDF_TARGET="esp32s3"

CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y

CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y

# YD-ESP32-S3 用板载 USB-C（USB Serial/JTAG）做控制台，才能在监视器里输入 wifi 等命令
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
# CONFIG_ESP_CONSOLE_UART_DEFAULT is not set

CONFIG_BOOTLOADER_LOG_LEVEL_WARN=y
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# 高度嗅探 GPIO ISR 会在 Flash cache 暂停期间运行；其 gpio_get_level 依赖必须驻留 IRAM。
CONFIG_GPIO_CTRL_FUNC_IN_IRAM=y

# 真机已证实被动 GPIO 嗅探会干扰 0x24；保持旧实验路径关闭。
# CONFIG_DESK_YOURDESK_HEIGHT_SNIFFER_EXPERIMENTAL is not set
CONFIG_DESK_YOURDESK_SOFT_I2C_MULTI_ADDRESS=y
CONFIG_DESK_YOURDESK_PANEL_PROXY=y
CONFIG_DESK_MAX_HEIGHT_MM=1020

# 软件多地址 Slave 已通过升降和真实高度真机验收；默认不得回退到模拟值。
# CONFIG_DESK_SIM_HEIGHT is not set
