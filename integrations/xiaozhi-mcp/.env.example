# 复制为同目录的 .env 后填写真实值。.env 已被仓库根目录的 .gitignore 忽略。

# 小智控制台中目标智能体的完整 MCP Endpoint，必须包含 token。
MCP_ENDPOINT='wss://api.example.com/mcp/?token=replace-with-agent-token'

# 小智官方 78/mcp-calculator 的本地源码和 Python 3.10+ 虚拟环境。
MCP_PIPE_DIR='/absolute/path/to/mcp-calculator'
MCP_PYTHON='/absolute/path/to/mcp-calculator/.venv/bin/python'

# Desk Gateway 的局域网地址和 REST Key。
DESK_GATEWAY_URL='http://192.168.1.100'
DESK_GATEWAY_KEY='replace-with-desk-gateway-key'
DESK_HTTP_TIMEOUT_SECONDS='5'
